{
  "name": "todo-manager",
  "displayName": "TODO Manager",
  "description": "Find and manage TODO comments in your workspace",
  "version": "0.0.1",
  "publisher": "student",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
  "onCommand:todo-manager.helloWorld",
  "onCommand:todo-manager.refresh",
  "onView:todoManager"
],
  "main": "./out/extension.js",
  
"contributes": {
  "commands": [
    {
      "command": "todo-manager.helloWorld",
      "title": "TODO Manager: Hello World"
    },
    {
    "command": "todo-manager.refresh",
    "title": "TODO Manager: Refresh"
  }
  ],
  "views": {
    "explorer": [
      {
        "id": "todoManager",
        "name": "TODO Manager"
      }
    ]
  }
},
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5"
  }
}
